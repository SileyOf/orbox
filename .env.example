# 这个文件是可选的：不写数据库配置时，启动后第一次打开网页会进入安装向导，
# 在网页里填写数据库、站点名称和管理员账号（配置保存在数据目录 /app/data 里）。
# 这里写了的配置优先于向导保存的配置。

# 服务端口
PORT=8787
# 对外访问地址（用于 Telegram 消息里的"打开"链接）
PUBLIC_URL=https://mail.example.com
# MySQL 8
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=orbox
DB_PASSWORD=
DB_NAME=orbox
# 用于加密邮箱密码的主密钥：openssl rand -hex 32。丢失后已保存的邮箱密码无法解密
APP_SECRET=
# 初始注册策略，之后在后台"注册与用户"里修改（第一个注册的用户自动成为管理员）
ALLOW_REGISTRATION=true
# Telegram 机器人 Token（@BotFather 获取），留空则不启用
TELEGRAM_BOT_TOKEN=
# 可选：服务器无法直连 Telegram 时使用的 HTTP 代理，如 http://127.0.0.1:7890
TELEGRAM_PROXY=
# 可选：Outlook / Microsoft 365 登录（OAuth）。在 Microsoft Entra 注册应用后填写，详见 docs/DEPLOY.md
# 未填写时默认使用免配置 paste 模式（Thunderbird 公共客户端）；设为空字符串 MS_PUBLIC_CLIENT_ID= 可禁用
MS_CLIENT_ID=
MS_CLIENT_SECRET=
# MS_PUBLIC_CLIENT_ID=9e5f94bc-e8a4-4e73-b8be-63364c29d753

# Gmail 的 Google 账号登录（OAuth）。也可以在 后台 → 集成 里填，后台填的优先
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 可选：若不想配公网回调域名，可填写桌面端 OAuth 客户端走 paste 模式（redirect_uri=http://localhost）
# GOOGLE_DESKTOP_CLIENT_ID=
# GOOGLE_DESKTOP_CLIENT_SECRET=

# ---- 聊天机器人（可选）：推荐在网页后台 → 集成 里配置，这里只作为初始值 ----
# 飞书 / Lark 自建应用（长连接模式，不需要公网回调地址）
FEISHU_APP_ID=
FEISHU_APP_SECRET=
# feishu（国内飞书）或 lark（海外版）
FEISHU_DOMAIN=feishu
# Discord 机器人 Token
DISCORD_BOT_TOKEN=
# Slack（Socket Mode）：xoxb- 开头的 Bot Token 和 xapp- 开头的 App-Level Token
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=

# ---- AI（可选）----
# 推荐在网页里配置模型服务。这里的配置会在启动时转换成后台的"共享模型"，AI_SHARED=true 时所有用户都能用（费用由你承担）
AI_PROVIDER=
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_FAST_MODEL=
AI_SHARED=false

# 运行日志同时写入这个目录下的 orbox.log（docker-compose.yml 里已默认设为 /app/logs）
# LOG_DIR=/app/logs

# 安装向导的安装码。不设置时每次启动随机生成并打印在日志里（docker compose logs | grep 安装码）
# SETUP_CODE=

# 安装向导保存配置的目录（Docker 镜像里默认 /app/data，需要挂载卷）
# DATA_DIR=/app/data

# 紧急开关：设为 true 后登录跳过两步验证。只在管理员自己被锁在外面（手机丢了、恢复码也没了）时使用，
# 登录后重新设置两步验证，然后删掉这一行并重启
# ORBOX_DISABLE_2FA=true
