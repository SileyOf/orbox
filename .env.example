# 服务端口
PORT=8787
# 对外访问地址（用于 Telegram 消息里的"打开"链接）
PUBLIC_URL=https://mail.example.com
# MySQL 8
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=orbox
DB_PASSWORD=
DB_NAME=orbox
# 用于加密邮箱密码的主密钥：openssl rand -hex 32。丢失后已保存的邮箱密码无法解密
APP_SECRET=
# 初始注册策略，之后在后台"注册与用户"里修改（第一个注册的用户自动成为管理员）
ALLOW_REGISTRATION=true
# Telegram 机器人 Token（@BotFather 获取），留空则不启用
TELEGRAM_BOT_TOKEN=
# 可选：服务器无法直连 Telegram 时使用的 HTTP 代理，如 http://127.0.0.1:7890
TELEGRAM_PROXY=
# 可选：Outlook / Microsoft 365 登录（OAuth）。在 Microsoft Entra 注册应用后填写，详见 docs/DEPLOY.md
MS_CLIENT_ID=
MS_CLIENT_SECRET=

# ---- 聊天机器人（可选）：推荐在网页后台 → 集成 里配置，这里只作为初始值 ----
# 飞书 / Lark 自建应用（长连接模式，不需要公网回调地址）
FEISHU_APP_ID=
FEISHU_APP_SECRET=
# feishu（国内飞书）或 lark（海外版）
FEISHU_DOMAIN=feishu
# Discord 机器人 Token
DISCORD_BOT_TOKEN=
# Slack（Socket Mode）：xoxb- 开头的 Bot Token 和 xapp- 开头的 App-Level Token
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=

# ---- AI（可选）----
# 推荐在网页里配置模型服务。这里的配置会在启动时转换成后台的"共享模型"，AI_SHARED=true 时所有用户都能用（费用由你承担）
AI_PROVIDER=
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_FAST_MODEL=
AI_SHARED=false

# 运行日志同时写入这个目录下的 orbox.log（docker-compose.yml 里已默认设为 /app/logs）
# LOG_DIR=/app/logs
